# Mobile Node.js API Configuration
PORT=3019

# MySQL Database (localhost when running on same EC2)
DB_HOST=127.0.0.1
DB_USER=vltd_user
DB_PASSWORD=ChangeMeStrongPassword123!
DB_DATABASE=vltd_mobile

# JWT Secret (must match what your mobile app expects)
JWT_SECRET=replace-with-your-jwt-secret

# Rust VLTD Gateway HTTP API
# Use http://127.0.0.1:8080 when running on the same EC2 as rustAis,
# or http://43.205.66.193:8080 if running on a separate server.
RUST_API_URL=http://127.0.0.1:8080
