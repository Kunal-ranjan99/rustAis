# VLTD AIS-140 Rust Gateway Configuration
TCP_BIND_ADDR=0.0.0.0:5001
HTTP_BIND_ADDR=0.0.0.0:8080

# Redis (live state cache)
REDIS_URL=redis://127.0.0.1:6379

# InfluxDB v2 (time-series database backed by EBS volume)
INFLUX_HOST=http://127.0.0.1:8086
INFLUX_ORG=my-org
INFLUX_BUCKET=vltd_data
INFLUX_TOKEN=my-super-secret-influx-token

# Direct EBS append-only raw NDJSON archive (leave blank to disable)
EBS_DATA_DIR=/mnt/ebs/vltd_raw

# Concurrency & Safety Limits
MAX_TCP_CONNECTIONS=5000
TCP_IDLE_TIMEOUT_SECS=90
RECENT_BUFFER_SIZE=20
RUST_LOG=info
